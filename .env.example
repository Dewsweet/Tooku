# Default Navidrome for local source development / 本机源码开发默认上游。
# Vite reads this file after it is copied to .env. Docker deployment is configured
# directly in compose.yaml / Docker 部署直接修改 compose.yaml，无需此文件。
# For native production, set process environment variables.
# Never put passwords, API keys or tokens here / 不填写账号密码或密钥。
NAVIDROME_UPSTREAM=http://127.0.0.1:4533
