# Default Navidrome for local development / 本机开发默认上游。
# Vite reads NAVIDROME_UPSTREAM here; Docker Compose also reads this file after
# it is copied to .env. For native production, set process environment variables.
# Never put passwords, API keys or tokens here / 不填写账号密码或密钥。
NAVIDROME_UPSTREAM=http://127.0.0.1:44533

# Docker: use an address reachable FROM the container, for example:
# NAVIDROME_UPSTREAM=http://host.docker.internal:4533
# NAVIDROME_UPSTREAM=https://music.example.com:22443

# Docker Compose settings / 容器配置：
# TOOKU_BIND_ADDRESS=127.0.0.1
# TOOKU_HTTP_PORT=8080
# TOOKU_ALLOW_PRIVATE_NAVIDROME=false
# TOOKU_TRUST_PROXY=false
# TOOKU_COOKIE_SECURE=false
# TOOKU_HSTS=false
