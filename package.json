{
  "name": "tooku",
  "version": "0.1.0",
  "description": "A self-hosted Navidrome web player / 自托管 Navidrome 第三方网页播放器",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Dewsweet/Tooku.git" },
  "homepage": "https://github.com/Dewsweet/Tooku",
  "bugs": { "url": "https://github.com/Dewsweet/Tooku/issues" },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "runtime:check": "node scripts/check-node-version.mjs",
    "predev": "npm run runtime:check",
    "dev": "node scripts/dev-server.mjs",
    "predev:lan": "npm run runtime:check",
    "dev:lan": "node scripts/dev-server.mjs --lan",
    "prestart": "npm run runtime:check",
    "start": "node server/index.ts",
    "prebackup": "npm run runtime:check",
    "backup": "node server/backup.ts",
    "prebuild": "npm run runtime:check",
    "build": "tsc -b && vite build",
    "prepreview": "npm run runtime:check",
    "preview": "vite preview --host 127.0.0.1",
    "pretypecheck": "npm run runtime:check",
    "typecheck": "tsc -b",
    "prelint": "npm run runtime:check",
    "lint": "eslint .",
    "pretest": "npm run runtime:check",
    "test": "node --test scripts/check-node-version.node-test.mjs scripts/container-healthcheck.node-test.mjs && vitest run",
    "pretest:watch": "npm run runtime:check",
    "test:watch": "vitest",
    "security:audit": "npx --yes pnpm@11.25.0 audit --prod --audit-level=low && npx --yes pnpm@11.25.0 audit --audit-level=low && node scripts/audit-signatures.mjs",
    "security:sbom": "node scripts/generate-sbom.mjs --output .local/security/tooku-prod.cdx.json && node scripts/generate-sbom.mjs --all --output .local/security/tooku-all.cdx.json",
    "security:licenses": "node scripts/license-notices.mjs && git diff --exit-code -- docs/THIRD_PARTY_NOTICES.md public/third-party-notices.txt",
    "security:baseline": "npm run security:audit && npm run security:sbom && npm run security:licenses",
    "precontainer:check": "npm run runtime:check",
    "container:check": "node scripts/check-container-config.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "blueimp-md5": "2.19.0",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/blueimp-md5": "2.18.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
