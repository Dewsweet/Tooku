log_format tooku '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status';
server {
    listen 8080;
    server_name _;
    access_log /var/log/nginx/access.log tooku;
    # Upstream error details can contain credential-bearing query strings.
    error_log /var/log/nginx/error.log crit;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Playback grants are bearer-like random path segments. Never write them to access logs.
    location ^~ /api/tooku-stream/ {
        access_log off;
        proxy_pass ${TOOKU_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Optional outer proxy. TOOKU_UPSTREAM points to the Node service, not Navidrome.
        proxy_pass ${TOOKU_UPSTREAM};
        proxy_http_version 1.1;
        client_max_body_size 13m;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
