log_format tooku '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status';
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log tooku;
    # Upstream error details can contain credential-bearing query strings.
    error_log /var/log/nginx/error.log crit;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
    location = /index.html {
        add_header Cache-Control "no-store";
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location /nd/rest/ {
        proxy_pass ${NAVIDROME_UPSTREAM}/rest/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        access_log off;
    }
}
